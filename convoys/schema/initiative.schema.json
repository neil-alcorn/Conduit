{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Initiative",
  "type": "object",
  "required": ["id", "title", "urgency", "importance", "status"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "urgency": { "enum": ["high", "low"] },
    "importance": { "enum": ["high", "low"] },
    "status": { "enum": ["active", "done"] }
  }
}
